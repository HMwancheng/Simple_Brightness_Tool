<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BrightnessWpf</RootNamespace>
    <AssemblyName>BrightnessWpf</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\app.ico\Icon_App.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 托盘改用 WinForms NotifyIcon：H.NotifyIcon 在单文件发布下无法创建托盘图标 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- 内嵌托盘图标为资源（单文件发布下可靠加载） -->
  <ItemGroup>
    <EmbeddedResource Include="..\app.ico\Icon_Tray_Hybrid.ico" LogicalName="BrightnessWpf.Resources.Icon_Tray_Hybrid.ico" />
  </ItemGroup>

</Project>