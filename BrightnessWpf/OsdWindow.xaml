<Window x:Class="BrightnessWpf.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD"
        Width="290"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Border Background="#E8282828" CornerRadius="8" BorderBrush="#66505050" BorderThickness="1" Padding="20,12">
        <ItemsControl x:Name="OsdList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xEC8A;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="White" FontSize="14" VerticalAlignment="Center" TextAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                                     Value="{Binding Brightness}" VerticalAlignment="Center"
                                     Margin="2,0,6,0" Background="#808080" Foreground="#0078D4" BorderThickness="0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Brightness}" Foreground="White"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
