<Window x:Class="BrightnessWpf.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD"
        Width="300"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Border Background="#E8202020" CornerRadius="24" BorderBrush="#4D4D4D" BorderThickness="1" Padding="22,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="42"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xEC8A;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                       FontSize="18" VerticalAlignment="Center" TextAlignment="Center"/>
            <ProgressBar Grid.Column="1" x:Name="TrackBar" Height="6" Minimum="0" Maximum="100"
                         VerticalAlignment="Center" Margin="8,0,10,0"
                         Background="#4D4D4D" Foreground="White" BorderThickness="0"/>
            <TextBlock Grid.Column="2" x:Name="ValueText" Text="0" Foreground="White" FontSize="14"
                       FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>
    </Border>
</Window>
