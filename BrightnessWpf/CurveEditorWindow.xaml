<Window x:Class="BrightnessWpf.CurveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="曲线编辑器"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <!-- 曲线画布 -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Canvas x:Name="GraphCanvas" ClipToBounds="True" Background="Transparent"
                    MouseDown="GraphCanvas_MouseDown" MouseMove="GraphCanvas_MouseMove" MouseUp="GraphCanvas_MouseUp"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="左键拖拽/加点，右键删点" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="重置" Width="72" Height="30" Margin="0,0,8,0" Click="Reset_Click"/>
            <Button Content="保存" Width="72" Height="30" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="关闭" Width="72" Height="30" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
