<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DPI Awareness for high DPI displays -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 生成单文件，体积小 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 软件名称 -->
    <AssemblyName>HM's Simple Brightness Tool</AssemblyName>
    <!-- 作者 -->
    <Company>HMwancheng</Company>
    <Authors>HMwancheng</Authors>
    <!-- 应用程序图标 -->
    <ApplicationIcon>app.ico\Icon_App.ico</ApplicationIcon>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  
  <!-- 将托盘图标文件嵌入为资源 -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico\Icon_Tray_Hybrid.ico" />
    <EmbeddedResource Include="app.ico\Icon_Tray_Minimalist.ico" />
    <EmbeddedResource Include="app.ico\Icon_Tray_Transparent.ico" />
  </ItemGroup>

  <!-- 排除独立的 WPF 迁移项目目录，避免干扰 WinForms 编译 -->
  <ItemGroup>
    <Compile Remove="BrightnessWpf\**" />
    <Page Remove="BrightnessWpf\**" />
    <EmbeddedResource Remove="BrightnessWpf\**" />
    <None Remove="BrightnessWpf\**" />
  </ItemGroup>
</Project>
